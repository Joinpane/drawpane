{
  "name": "@drawpane/agent-runner",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "The agent runner (decision 0033): a Worker of its own whose AgentRunner Durable Object runs agent tools, with the headless editor, HarfBuzz and the render engine, outside the file's room.",
  "type": "module",
  "scripts": {
    "types": "wrangler types --include-runtime=false src/worker-configuration.d.ts",
    "typecheck": "tsc -p .",
    "build": "node scripts/cap-wasm.ts && wrangler deploy --dry-run --outdir dist",
    "deploy": "node scripts/cap-wasm.ts && wrangler deploy"
  },
  "dependencies": {
    "@drawpane/editor": "workspace:*",
    "@drawpane/engine": "workspace:*",
    "@drawpane/model": "workspace:*",
    "@drawpane/raster": "workspace:*",
    "@drawpane/worker": "workspace:*",
    "harfbuzzjs": "1.6.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261113.1",
    "@types/node": "26.6.6",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
