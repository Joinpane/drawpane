{
  "name": "@drawpane/worker",
  "version": "0.0.0",
  "private": true,
  "license": "MPL-2.0",
  "description": "The Drawpane Cloudflare Worker: routing, auth, REST API, static assets and the FileRoom Durable Object.",
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev",
    "types": "wrangler types --include-runtime=false src/worker-configuration.d.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@drawpane/model": "workspace:*",
    "@simplewebauthn/server": "14.1.0",
    "hono": "4.13.18",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.8.1",
    "@cloudflare/workers-types": "5.20261113.1",
    "@simplewebauthn/browser": "14.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
