{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "drawpane",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Up to five minutes of CPU per request (the most Cloudflare allows; billed as used): a room
  // committing an import, restore or merge of a few hundred thousand layers works for tens of
  // seconds in one call (docs/decisions/0026-large-files-on-the-server.md).
  "limits": { "cpu_ms": 300000 },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  // The agent runner is a script of its own (apps/agent-runner, decision 0033): an agent call that
  // runs out of memory resets its isolate, never a file's room. Deploy it first: this binds it.
  "durable_objects": {
    "bindings": [
      { "name": "FILE_ROOM", "class_name": "FileRoom" },
      {
        "name": "AGENT_RUNNER",
        "class_name": "AgentRunner",
        "script_name": "drawpane-agent-runner"
      }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FileRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drawpane",
      "database_id": "82cecbce-29d8-4a51-8b09-4ee3d72e5296",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "drawpane-files" }],
  "vars": { "RP_NAME": "Drawpane" },
  // Emails about the inbox, every five minutes (src/email/notify.ts); nothing when email is off.
  "triggers": { "crons": ["*/5 * * * *"] }
  // No route here: your domain is passed at deploy time (`--domain`, see
  // docs/self-hosting.md), so it never has to be committed.
}
