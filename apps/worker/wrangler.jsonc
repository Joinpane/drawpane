{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "drawpane",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "FILE_ROOM", "class_name": "FileRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FileRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "drawpane",
      "database_id": "82cecbce-29d8-4a51-8b09-4ee3d72e5296",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "drawpane-files" }],
  "vars": { "RP_NAME": "Drawpane" },
  // The dogfooding instance. Self-hosters change this to their own domain.
  "routes": [{ "pattern": "design.example.com", "custom_domain": true }]
}
