  "private": true,
  "license": "MPL-2.0",
  "description": "The Drawpane browser app: sign-in, dashboard and the editor.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
