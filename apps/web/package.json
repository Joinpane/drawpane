    "@simplewebauthn/browser": "14.0.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "jspdf": "4.2.1",
    "pathkit-wasm": "1.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svg2pdf.js": "2.9.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fast-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
