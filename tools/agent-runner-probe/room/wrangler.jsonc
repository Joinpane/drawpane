// drawpane-oom-probe-room. No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID.
// Deploy the runner first: both bindings below point at its script.
{
  "name": "drawpane-oom-probe-room",
  "main": "room.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "services": [{ "binding": "RUNNER", "service": "drawpane-oom-probe-runner" }],
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ProbeRoom" },
      { "name": "RUNNER_DO", "class_name": "RunnerDO", "script_name": "drawpane-oom-probe-runner" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeRoom"] }],
  "observability": { "enabled": true }
}
