{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "fuzz": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["FUZZ_SEED", "FUZZ_RUNS", "FUZZ_LENGTH"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@drawpane/worker#build": {
      "dependsOn": ["@drawpane/web#build"],
      "outputs": []
    },
    "@drawpane/worker#test": {
      "dependsOn": ["@drawpane/web#build"],
      "outputs": []
    }
  }
}
