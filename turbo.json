{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "fuzz": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["FUZZ_SEED", "FUZZ_RUNS", "FUZZ_LENGTH", "FUZZ_NO_SHRINK"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@drawpane/worker#build": {
      "dependsOn": ["@drawpane/web#build"],
      "outputs": ["dist/**"]
    },
    "@drawpane/worker#test": {
      "dependsOn": ["@drawpane/web#build"],
      "outputs": []
    },
    "create-drawpane#build": {
      "dependsOn": [
        "@drawpane/worker#build",
        "@drawpane/agent-runner#build",
        "@drawpane/web#build"
      ],
      "outputs": ["dist/**", "server/**"]
    },
    "@drawpane/engine#build": {
      "outputs": ["dist/**"],
      "env": ["ENGINE_SKIP_BUILD", "ENGINE_ONLY"]
    },
    "@drawpane/engine#test": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
